#!/usr/bin/env bash
# Gets a fresh clone ready to work on: checks for Rust and Node 22, installs
# the frontend's packages and builds web/dist, fetches the crates, and turns
# on the pre-push checks. Safe to run again. Starts nothing.
#
# Rust is compiled by the first `cargo run -- serve` (README.md). board.toml
# is written by that first run, with a fresh server_secret, so it isn't copied
# here. Browser tests stay opt-in, since they download Chromium:
#   (cd e2e && npm install && npx playwright install chromium)
set -euo pipefail
cd "$(dirname "$0")/.."

die() { echo "bin/setup: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

have cargo || die "Rust is missing. Install it with: curl --proto '=https' -sSf https://sh.rustup.rs | sh"
cargo --version | awk '{ split($2, v, "."); exit !(v[1] > 1 || v[2] >= 85) }' ||
  die "Rust is too old for edition 2024 ($(cargo --version)). Update it with: rustup update stable"
have node || die "Node is missing. Install it with: brew install node"
[ "$(node -p 'process.versions.node.split(".")[0]')" -ge 22 ] ||
  die "Board needs Node 22 or newer (this is $(node --version)). Install it with: brew install node"

echo "== frontend"
# npm ci only when package-lock.json is newer than the last install.
if [ ! web/node_modules/.package-lock.json -nt web/package-lock.json ]; then
  (cd web && npm ci --no-audit --no-fund --silent)
fi
(cd web && npm run -s build)

echo "== crates"
cargo fetch

echo "== pre-push checks"
git config core.hooksPath .githooks

echo
echo "Ready. Next: cargo run -- serve (http://localhost:7070), then cargo run -- login for a sign-in link; npm run watch in web/ for frontend work."
